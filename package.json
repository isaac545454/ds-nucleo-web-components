{
  "name": "@isaac545454/nucleus",
  "version": "0.6.0",
  "description": "Design system agnóstico em web components, compilado com Stencil.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaac545454/ds-nucleo-web-components.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.js",
  "types": "./dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/nucleus/nucleus.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/nucleus/nucleus.esm.js",
      "require": "./dist/nucleus/nucleus.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs"
    },
    "./custom-elements": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*",
      "import": "./dist/components/*"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build && cp src/global/global.css dist/styles.css",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --ci && vitest run",
    "test:spec": "stencil test --spec --ci",
    "typecheck": "tsc --noEmit --pretty false",
    "storybook": "pnpm build && concurrently -k -n stencil,storybook \"stencil build --watch\" \"storybook dev -p 6006\"",
    "build-storybook": "pnpm build && storybook build"
  },
  "devDependencies": {
    "@stencil/core": "^4.38.3",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/web-components-vite": "10.6.1",
    "@types/jest": "^29.5.14",
    "concurrently": "10.0.6",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "lit": "3.3.3",
    "storybook": "10.6.1",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
